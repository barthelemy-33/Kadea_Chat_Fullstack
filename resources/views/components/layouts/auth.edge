<!DOCTYPE html>
<html
  lang="fr"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kadea Chat</title>
    @vite(['resources/css/app.css', 'resources/css/auth.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="auth">
      <div class="auth__form-col">
        <a href="/" class="kc-brand">
          <span class="kc-brand__mark">
            @svg('lucide:message-circle', { width: 18, height: 18 })
          </span>
          <span class="kc-brand__name">Kadea Chat</span>
        </a>
        <div class="auth__form-wrap">{{{ await $slots.main() }}}</div>
        <div style="height: 20px;"></div>
      </div>

      <aside class="auth__aside kc-aside">
        @include('partials/auth_art')

        <div class="kc-aside__top">
          @!themeToggle()
        </div>

        <div class="kc-hero">
          <h2 class="kc-hero__title">Discutez simplement, en privé ou en groupe.</h2>
          <p class="kc-hero__text">
            Des messages instantanés, des conversations protégées, sur ordinateur comme sur téléphone.
          </p>
          <ul class="kc-points">
            <li>
              @svg('lucide:message-circle', { width: 18, height: 18 })
              
              
              
              
              Messages en privé 




            </li>
            <li>
              @svg('lucide:users', { width: 18, height: 18 })
              
              
              
              
              Messages en groupe




            </li>
            <li>
              @svg('lucide:shield-check', { width: 18, height: 18 })
              
              
              
              
              Sécurité 




            </li>
          </ul>
        </div>

        <p class="kc-foot">Kadea Academy</p>
      </aside>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>
