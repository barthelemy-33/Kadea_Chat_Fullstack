@layouts.auth()
  <h1 class="auth__title">Mot de passe oublié ?</h1>
  <p class="auth__sub">Entre ton adresse e-mail, on t'envoie un lien pour le réinitialiser.</p>
  @form({
    route: 'forgot_password.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'toi@exemple.com',
      })
      @!field.error()
    @end
    @!button({
      text: 'Envoyer le lien',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Envoi en cours…' : 'Envoyer le lien'",
    })
  @end

  <p class="auth__foot">
    @link({ route: 'session.create', class: 'il' })
      Retour à la connexion
    @end
  </p>
@end
