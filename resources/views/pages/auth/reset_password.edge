@layouts.auth()
  <h1 class="auth__title">Nouveau mot de passe</h1>
  <p class="auth__sub">Choisis un nouveau mot de passe pour ton compte.</p>
  @form({
    route: 'reset_password.store',
    routeParams: { token },
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'password' })
      @!field.label({ text: 'Nouveau mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
      })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirme le mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
      })
      @!field.error()
    @end
    @!button({
      text: 'Changer le mot de passe',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Envoi en cours…' : 'Changer le mot de passe'",
    })
  @end

  <p class="auth__foot">
    @link({ route: 'session.create', class: 'il' })
      Retour à la connexion
    @end
  </p>
@end
