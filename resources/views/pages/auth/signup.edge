@layouts.auth()
  <h1 class="auth__title">Crée ton compte</h1>
  <p class="auth__sub">Rejoins Kadea Chat et commence à discuter.</p>
  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Nom complet' })
      @!input.control({ autocomplete: 'name', placeholder: 'Ex : Marie Kabongo' })
      @!field.error()
    @end
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'toi@exemple.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      <small style="color: var(--muted); font-size: 12.5px;">Entre 8 et 32 caractères.</small>
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirme le mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Créer mon compte',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Création…' : 'Créer mon compte'",
    })
  @end

  <p class="auth__foot">
    
    Tu as déjà un compte ?

    @link({ route: 'session.create', class: 'il' })
      Se connecter
    @end
  </p>
@end
