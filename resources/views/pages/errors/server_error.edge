@layouts.plain({ title: 'Un problème est survenu' })
  <div class="kc-empty">
    <div class="kc-empty__mark">
      @svg('lucide:info', { width: 30, height: 30 })
    </div>
    <p class="kc-code">Erreur</p>
    <h1>Un problème est survenu</h1>
    <p>Réessaie dans un instant. Si le problème continue, préviens l'administrateur.</p>
    <a href="/dashboard" class="kc-btn">Retour à l'accueil</a>
  </div>
@end
