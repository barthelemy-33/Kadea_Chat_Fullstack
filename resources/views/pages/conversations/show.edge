@layouts.app({ title: 'Conversation' })
  @page()
    <h1>{{ title }}</h1>
    @if(conversation.type === 'group')
      <h2>Membres ({{ memberItems.length }})</h2>
      <ul>
        @each(member in memberItems)
          <li>
            {{ member.name }}
            @if(member.role === 'admin')
              <strong>(admin)</strong>
            @end
            @if(isAdmin && member.id !== me)
              @form({
                route: 'members.destroy',
                routeParams: { id: conversation.id, userId: member.id },
                method: 'POST',
              })
                @!button({ text: 'Retirer', type: 'submit' })
              @end
            @end
          </li>
        @end
      </ul>
      @if(isAdmin && candidates.length > 0)
        @form({
          route: 'members.store',
          routeParams: { id: conversation.id },
          method: 'POST',
        })
          <select name="userId">
            @each(user in candidates)
              <option value="{{ user.id }}">{{ user.fullName || user.email }}</option>
            @end
          </select>
          @!button({ text: 'Ajouter', type: 'submit' })
        @end
      @end
      @if(!isAdmin)
        @form({
          route: 'members.leave',
          routeParams: { id: conversation.id },
          method: 'POST',
        })
          @!button({ text: 'Quitter le groupe', type: 'submit' })
        @end
      @end
    @end

    <div x-data="chatRoom('conversations/{{ conversation.id }}/messages', '{{ csrfToken }}')">
      @if(messages.length === 0)
        <p x-ref="empty">Aucun message pour l'instant. Écris le premier !</p>
      @end

      <div x-ref="list">
        @each(message in messages)
          <div id="message-{{ message.id }}" style="margin-bottom: 12px;">
            <strong>{{ message.sender.fullName || message.sender.email }}</strong>
            <small>{{ message.createdAt.toFormat('HH:mm') }}</small>
            <p data-body>
              @if(message.deletedAt)
                <em>
                  Ce message a été supprimé le
                  {{ message.deletedAt.toFormat('dd/MM à HH:mm') }}
                </em>
              @else
                {{ message.content }}
              @end
            </p>
            @if(message.senderId === me && !message.deletedAt)
              <div data-delete>
                @form({
                  route: 'messages.destroy',
                  routeParams: { id: message.id },
                  method: 'POST',
                })
                  @!button({ text: 'Supprimer', type: 'submit' })
                @end
              </div>
            @end
          </div>
        @end
      </div>
    </div>
    @form({
      route: 'messages.store',
      routeParams: { id: conversation.id },
      method: 'POST',
    })
      @field.root({ name: 'content' })
        @!input.control({
          type: 'text',
          placeholder: 'Écris un message...',
          autocomplete: 'off',
        })
        @!field.error()
      @end
      @!button({ text: 'Envoyer', type: 'submit' })
    @end
  @end
@end
