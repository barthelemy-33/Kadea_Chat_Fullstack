@layouts.app({ title: 'Dashboard' })
  @page()
    <h1>Utilisateurs</h1>
    @each(user in users)
      @form({ route: 'conversations.store', method: 'POST' })
        <input type="hidden" name="userId" value="{{ user.id }}" />
        <span>{{ user.fullName || user.email }}</span>
        @!button({ text: 'Discuter', type: 'submit' })
      @end
    @end

    <h2>Mes conversations</h2>
    @if(conversationItems.length === 0)
      <p>Aucune conversation pour l'instant. Choisis quelqu'un dans la liste des utilisateurs.</p>
    @end
    @each(item in conversationItems)
      @link({ route: 'conversations.show', routeParams: { id: item.id } })
        @if(item.avatarUrl)
          <img
            src="{{ item.avatarUrl }}"
            alt=""
            style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;"
          />
        @else
          <span
            style="display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: #0f766e; color: #fff; font-size: 14px;"
          >
            {{ item.initials }}
          </span>
        @end

        <strong>{{ item.title }}</strong>
        <small>{{ item.date }}</small>
        <p>{{ item.preview }}</p>
      @end
    @end
  @end
@end
