@layouts.app({ title: 'Dashboard' })
  @page()
    <h1>Utilisateurs</h1>
    @each(user in users)
      @form({ route: 'conversations.store', method: 'POST' })
        <input type="hidden" name="userId" value="{{ user.id }}" />
        <span>{{ user.fullName || user.email }}</span>
        @!button({ text: 'Discuter', type: 'submit' })
      @end
    @end

    <h2>Mes conversations</h2>
    @if(conversations.length === 0)
      <p>Aucune conversation pour l'instant. Choisis quelqu’un dans la liste des utilisateurs.</p>
    @end
    @each(conversation in conversations)
      @let(other = conversation.members.find((member) => member.id !== me))
      @link({ route: 'conversations.show', routeParams: { id: conversation.id } })
        {{ other ? other.fullName || other.email : 'Conversation' }}
      @end
    @end
  @end
@end
